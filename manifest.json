{
  "manifest_version": 3,
  "name": "Canvas Download Sorter",
  "version": "1.0.0",
  "description": "Saves files downloaded from Canvas into a folder for each course.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://canvas.harvard.edu/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://canvas.harvard.edu/courses/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Canvas Download Sorter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
